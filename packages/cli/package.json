{
  "name": "@arak/cli",
  "version": "0.1.0",
  "description": "The arak command line — sync the personal-data catalog with the code and gate CI on it",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "arak": "./dist/index.js"
  },
  "exports": {
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@arak/core": "workspace:*",
    "@arak/detect-th": "workspace:*",
    "@arak/prisma": "workspace:*",
    "yaml": "^2.6.1"
  }
}
